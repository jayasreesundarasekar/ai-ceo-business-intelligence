# --- Server ---
PORT=8787
# Comma-separated list of origins allowed to call this API (your frontend dev/prod URLs)
CORS_ORIGIN=http://localhost:5173

# --- Groq (hosted, free, open-source LLM inference — no local install) ---
# Get a free API key at https://console.groq.com/keys
# Free tier has generous rate limits but is not literally unlimited — for a
# hackathon demo's request volume it won't get in the way.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Used only by Data Import to read text out of uploaded images (receipts,
# screenshots, photographed documents). Must be a vision-capable model —
# check https://console.groq.com/docs/models if this one is retired.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Supabase (real data + memory storage) ---
# Create a project at https://supabase.com, then run server/schema.sql
# in the Supabase SQL editor to create all tables.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the SERVICE ROLE key here (server-side only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Slack app ---
# Create an app at https://api.slack.com/apps (see server/README.md for the
# full step-by-step). You need a publicly reachable URL for the three
# request URLs below — use `ngrok http 8787` while developing.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Bot token (starts with xoxb-) — only needed if you want to skip OAuth during
# local dev and use a single workspace install directly ("Install to Workspace"
# in the Slack app dashboard gives you this).
SLACK_BOT_TOKEN=
# Where Slack should redirect after a user approves the OAuth install,
# e.g. https://abcd1234.ngrok.app/api/slack/oauth/callback
SLACK_REDIRECT_URI=http://localhost:8787/api/slack/oauth/callback

# --- Jira (real issue creation) ---
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=CEO

# --- HubSpot (real CRM sync) ---
# Create a private app at Settings -> Integrations -> Private Apps in HubSpot,
# with crm.objects.contacts.write and crm.objects.notes.write scopes.
HUBSPOT_ACCESS_TOKEN=

# --- Google (real Gmail send + Calendar scheduling) ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# (type: Web application). Enable the Gmail API and Calendar API for the
# project, and add GOOGLE_REDIRECT_URI below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/integrations/google/callback
